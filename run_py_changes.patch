     if mean:
         print('########### Mean steering cache ########### ', source_toks['input_ids'].shape[0], steer[0][0].shape, base[0][0].shape, len(steer[0]), len(base))
+        # .mean(0) reduces the BATCH only, leaving (seq_len, hidden): one
+        # steering vector per token position, not a single vector. That is fine
+        # while the steering and eval prompts share a padded length, and wrong
+        # the moment they do not -- which is exactly the cross-arm case.
         cache = [torch.cat(steer[i], dim=0).mean(0) - torch.cat(base[i], dim=0).mean(0) for i in range(num_layers)]
         print('########### Mean steering cache after ########### ', cache[0].shape)
+
+        reduce = getattr(data_handler.config.args, 'steer_reduce', 'none')
+        if reduce != 'none':
+            if reduce == 'last':
+                # Padding is left, so index -1 is the final real token of every
+                # prompt. This is the CAA convention: one vector, added at all
+                # positions, independent of prompt length.
+                cache = [c[-1:].clone() for c in cache]
+            else:
+                # Average over real tokens only. Left padding means the pads sit
+                # at the front, so the mask is shared across the batch and the
+                # first non-pad column can be read off the attention mask.
+                n_pad = int((source_toks['attention_mask'][:, 0] == 0).all().item()
+                            and (source_toks['attention_mask'] == 0).sum(1).min().item())
+                cache = [c[n_pad:].mean(0, keepdim=True) for c in cache]
+            print(f'########### steer_reduce={reduce}, shape now ',
+                  cache[0].shape, ' (broadcast to every eval position)')
     else:
         cache = [torch.cat(steer[i], dim=0) - torch.cat(base[i], dim=0) for i in range(num_layers)]
