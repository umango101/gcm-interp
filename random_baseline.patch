+def retrieve_random_k(num_layers, num_heads, k, seed=42, layer_counts=None):
+    """A random head set of the same size as the selected one.
+
+    layer_counts, when given, is {layer: n_heads_to_draw} -- the per-layer
+    histogram of the real top-k. Sampling within it makes the baseline
+    LAYER-MATCHED, which is the version that isolates the claim. Uniform
+    sampling across all layers is a weaker control: the ATP top-1% sits in a
+    narrow band of layers, so a uniform random set can fail because it drew the
+    wrong layers rather than because it drew the wrong heads inside them, and
+    the comparison then supports "depth matters" rather than "these heads do".
+
+    Run several seeds. One draw gives a point with no spread, and the question
+    is whether the real set beats the random DISTRIBUTION.
+    """
     rng = random.Random(seed)
-    total = num_layers * num_heads
-    num_samples = int(k * total)
-    all_combinations = [(l, h) for l in range(num_layers) for h in range(num_heads)]
-    selected = rng.sample(all_combinations, num_samples)
+    if layer_counts:
+        selected = []
+        for layer, n in sorted(layer_counts.items()):
+            n = min(int(n), num_heads)
+            selected.extend((int(layer), h)
+                            for h in rng.sample(range(num_heads), n))
+    else:
+        total = num_layers * num_heads
+        num_samples = int(k * total)
+        all_combinations = [(l, h) for l in range(num_layers) for h in range(num_heads)]
+        selected = rng.sample(all_combinations, num_samples)
     df = pd.DataFrame(selected, columns=['layer', 'neuron'])
     return df.sort_values(by=['layer', 'neuron'])
 
+
+def layer_histogram_of_topk(logits, topk, patch_algo):
