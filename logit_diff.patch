+def logit_diff_with_patches(model, gen_toks, patch_activations, topk_df, N,
+                            ablation_type, DIM, normalize=True,
+                            steering_type='last_token', head_site=None):
+    """Last-prompt-position logits under exactly the same interventions.
+
+    Generation-based scoring answers "what did the model say"; this answers "how
+    did the intervention move the decision", which is the logit difference ATP
+    differentiates and steers on. They come apart badly when the model declines
+    to answer in the expected shape: on the naive (no-preamble) test sets the
+    first sampled token is neither colour about half the time in devuser, so a
+    generation-scored cell there is mostly measuring off-task chatter while the
+    underlying preference is intact and measurable here.
+
+    One forward pass, no generation, so kv_caching is irrelevant: prefill covers
+    every prompt position and the write targets the whole o_proj slice.
+    Returns [batch, vocab] on cpu.
+    """
+    def _site(layer_module):
+        if head_site == 'o_proj_input':
+            return layer_module.self_attn.o_proj.input
+        return layer_module.self_attn.o_proj.output
+
+    patch_activations = patch_activations['desired'].to(model.device)
+    layer_ids = topk_df['layer'].unique()
+
+    def _steering_vector(layer_idx, sl):
+        # Deliberately identical to generate_with_patches: if these two ever
+        # diverge, the logit readout stops describing the generation it is
+        # meant to explain.
+        if steering_type == 'last_token':
+            vec = patch_activations[layer_idx][-1, sl]
+        elif steering_type == 'all_tokens':
+            vec = patch_activations[layer_idx][:, sl].mean(dim=0)
+        else:
+            raise ValueError(f"Unknown steering_type: {steering_type!r}")
+        if normalize:
+            vec = vec / (torch.norm(vec, dim=-1, keepdim=True) + 1e-12)
+        return vec
+
+    with torch.no_grad():
+        with model.trace(gen_toks) as _:
+            for layer_idx in layer_ids:
+                head_ids = topk_df[topk_df['layer'] == layer_idx]['neuron'].unique()
+                layer = model.model.layers[layer_idx]
+                for head_idx in head_ids:
+                    sl = slice(DIM * head_idx, DIM * (head_idx + 1))
+                    steering_vector = _steering_vector(layer_idx, sl)
+                    if ablation_type == 'mean':
+                        _site(layer)[..., sl] = N * steering_vector
+                    elif ablation_type == 'steer':
+                        _site(layer)[..., sl] += N * steering_vector
+            out = model.output.logits[:, -1, :].detach().cpu().save()
+    return out
+
+
+def first_token_ids(tokenizer, word):
+    """First-token id of each surface variant of a one-word answer.
+
+    Scoring against the bare lowercase form alone counts "Ivory" and " ivory"
+    as misses; on these corpora that inflated the off-task rate to ~40% while
+    the model's preference was correct.
+    """
+    ids = []
+    w = str(word).strip()
+    for v in (w, ' ' + w, w.capitalize(), ' ' + w.capitalize()):
+        enc = tokenizer.encode(v, add_special_tokens=False)
+        if enc and enc[0] not in ids:
+            ids.append(enc[0])
+    return ids
+
+
+def score_logit_diff(tokenizer, logits, dev_words, user_words):
+    """Per-item dev/user logits and their difference.
+
+    Takes the best surface variant of each word, so a capitalised target is not
+    penalised against a lowercase distractor. Items whose two words share a
+    first token are flagged rather than silently scored as a zero difference.
+    """
+    rows = []
+    for i in range(logits.shape[0]):
+        d_ids = first_token_ids(tokenizer, dev_words[i])
+        u_ids = first_token_ids(tokenizer, user_words[i])
+        shared = bool(set(d_ids) & set(u_ids))
+        d = max(float(logits[i, j]) for j in d_ids)
+        u = max(float(logits[i, j]) for j in u_ids)
+        top = int(logits[i].argmax())
+        rows.append({
+            'logit_dev': d,
+            'logit_user': u,
+            'logit_diff': d - u,          # >0 means the privileged word wins
+            'argmax_token': tokenizer.decode([top]),
+            'argmax_is_dev': top in d_ids,
+            'argmax_is_user': top in u_ids,
+            'first_token_collision': shared,
+        })
+    return rows
+
+
